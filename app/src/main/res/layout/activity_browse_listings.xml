<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F7F3E8">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_header_green"
        android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="52dp" android:paddingBottom="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔑 Quick Keys" android:textSize="13sp" android:textStyle="bold"
            android:textColor="#F0DFA0" android:fontFamily="serif" android:layout_marginBottom="6dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Browse Listings" android:textSize="28sp" android:textStyle="bold"
            android:textColor="#FFFCF2" android:fontFamily="serif"/>

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="4dp" android:background="#C8973A"/>

    <!-- Search + Sort bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#EDE6D0"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="14dp" android:paddingBottom="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">

            <EditText android:id="@+id/etSearch"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:background="@drawable/input_rounded"
                android:hint="Search make, model, or city..."
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:textColor="#0F3520" android:textColorHint="#999999"
                android:textSize="14sp" android:layout_marginEnd="8dp"/>

            <Button android:id="@+id/btnSearch"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:backgroundTint="#1B5E35" android:text="Search"
                android:textColor="#FFFCF2" android:textStyle="bold" android:textSize="13sp"/>

        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sort: " android:textColor="#0F3520"
                android:textStyle="bold" android:textSize="13sp" android:layout_marginEnd="8dp"/>

            <Spinner android:id="@+id/spinnerSort"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:backgroundTint="#1B5E35"/>

        </LinearLayout>
    </LinearLayout>

    <ListView android:id="@+id/listViewCars"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#F7F3E8" android:divider="@null" android:dividerHeight="0dp"
        android:paddingTop="10dp" android:paddingBottom="10dp"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:clipToPadding="false"/>

</LinearLayout>