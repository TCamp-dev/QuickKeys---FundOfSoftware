<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_header_green"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Hero section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="72dp"
            android:paddingBottom="40dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑"
                android:textSize="56sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Keys"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="#F0DFA0"
                android:fontFamily="serif"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find your perfect drive"
                android:textSize="16sp"
                android:textColor="#A8C4A0"
                android:letterSpacing="0.03"/>

        </LinearLayout>

        <!-- Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bottom_sheet"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="48dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="#C8973A"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="28dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign In"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#0F3520"
                android:fontFamily="serif"
                android:layout_marginBottom="28dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1B5E35"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/editUsername"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Enter your username"
                android:inputType="text"
                android:background="@drawable/input_rounded"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#BBBBBB"
                android:textSize="15sp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1B5E35"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:background="@drawable/input_rounded"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#BBBBBB"
                android:textSize="15sp"
                android:layout_marginBottom="28dp"/>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Login"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFCF2"
                android:backgroundTint="#1B5E35"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="#E0D4B0"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  or  " android:textColor="#AAAAAA" android:textSize="13sp"/>
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="#E0D4B0"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Create Account"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#1B5E35"
                android:backgroundTint="#E8D9A8"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>